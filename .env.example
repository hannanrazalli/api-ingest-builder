# Optional overrides. No editing is required; use the onboarding screen instead.
# Unset/empty values use settings saved by the UI.
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
MODEL_FAST=
MODEL_SMART=
# Model names have no defaults. Check vendor documentation for current names.
MAX_LLM_CALLS=
MAX_INPUT_TOKENS=
MAX_OUTPUT_TOKENS=

# Optional host-only local Codex settings; configure provider via UI or host env.
# LLM_PROVIDER accepts anthropic, openai, codex_cli.
MAX_PROMPT_CHARS=
CODEX_TIMEOUT_SECONDS=
