{% if flatten %}def flatten_record(value, prefix=""):
    if isinstance(value, dict):
        return {
            child_key: child_value
            for key, item in value.items()
            for child_key, child_value in flatten_record(
                item, f"{prefix}.{key}" if prefix else str(key)
            ).items()
        }
    if isinstance(value, list):
        return {
            child_key: child_value
            for index, item in enumerate(value)
            for child_key, child_value in flatten_record(
                item, f"{prefix}.{index}" if prefix else str(index)
            ).items()
        }
    return {prefix or "value": value}
records = [flatten_record(row) for row in records]
